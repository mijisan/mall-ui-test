<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >
<suite name="商城回归测试 suite" thread-count="3" parallel="tests" verbose="2" >
    <listeners>
        <listener class-name="listeners.AllureReportListener"/>
        <listener class-name="listeners.RetryListener"/>
    </listeners>
    <test name = "主页测试" >
        <parameter name="browser" value=""/>
        <classes>
            <class name="tests.HomePageTest"/>
        </classes>
    </test>
    <test name = "登录页测试" >
        <parameter name="browser" value=""/>
        <classes>
            <class name="tests.LoginPageTest"/>
        </classes>
    </test>
    <test name = "商品详情页测试" >
        <parameter name="browser" value=""/>
        <classes>
            <class name="tests.ProductPageTest"/>
        </classes>
    </test>
    <test name = "注册页测试" >
        <classes>
            <class name="tests.RegisterPageTest"/>
        </classes>
    </test>
    <test name = "购物流程测试" >
        <classes>
            <class name="tests.E2ETest"/>
        </classes>
    </test>
</suite>